# Base URL the browser uses for the Express API.
# Default "/api" goes through the Vite proxy (dev + preview) and needs no CORS.
# Set to e.g. http://localhost:5110 only after enabling CORS with credentials
# on the backend (see README).
VITE_API_BASE_URL=/api

# Where the Vite proxy forwards /api/* (server-side only, never sent to the browser).
# Must match PORT in backend/.env.
DEV_PROXY_TARGET=http://localhost:5110

# Artificial latency (ms) for mock services so loading states are visible.
VITE_MOCK_LATENCY_MS=150
